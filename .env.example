# ── Database ──
DATABASE_URL=postgresql://app:dev_password@localhost:5432/app

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── MinIO / S3 ──
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_DOCUMENTS=documents
S3_BUCKET_PHOTOS=photos
S3_BUCKET_EXPORTS=exports
S3_BUCKET_TEMP=temp

# ── ClamAV ──
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# ── Sessions ──
SESSION_SECRET=change_me_at_least_64_characters_long_random_string_here_please
SESSION_IDLE_TTL=1800
SESSION_ABSOLUTE_TTL=28800

# ── Auth — OIDC (internal staff, piem. Microsoft Entra ID) ──
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=https://login.microsoftonline.com/TENANT/v2.0
OIDC_CALLBACK_URL=http://localhost:5173/api/auth/oidc/callback
OIDC_ROLE_ADMIN=App.Admin
OIDC_ROLE_OPERATOR=App.Operator

# ── WebAuthn (external users — passkey login) ──
WEBAUTHN_RP_NAME=Secure Portal
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:5173

# ── TOTP ──
TOTP_ENCRYPTION_KEY=
TOTP_ISSUER=Secure Portal

# ── PII lauku šifrēšana ──
# Ģenerēt: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PII_ENCRYPTION_KEY=
# Blind index atslēga (HMAC-SHA256) — atsevišķa no šifrēšanas atslēgas
PII_BLIND_INDEX_KEY=
# Ieslēgt tikai PĒC datu migrācijas
PII_ENCRYPTION_ACTIVE=false

# ── Audit ──
AUDIT_HMAC_KEY=change_me_at_least_64_characters_long_random_string_here_please
AUDIT_EXPORT_DIR=./exports
AUDIT_EXPORT_HMAC_KEY=change_me_at_least_64_characters_long_random_string_here_please

# ── E-pasta piegādātājs ──
# Variants 1: SMTP (parastais piegādātājs)
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Variants 2: Microsoft Graph API (uzņēmuma Entra ID arenda)
# Lai pārslēgtos: EMAIL_PROVIDER=graph
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_TENANT_ID=
# MS_GRAPH_CLIENT_SECRET=
# MS_GRAPH_SENDER=

# ── App ──
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY=
COOKIE_SECURE=
PORTAL_URL=http://localhost:5173
DEV_ENDPOINTS=1
