{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "../..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": false,
    "sourceMap": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "noImplicitAny": false
  },
  "include": ["src", "../api/src/queue", "../api/src/prisma", "../api/src/audit", "../api/src/common"],
  "exclude": ["node_modules", "dist", "**/*.spec.ts", "**/*.test.ts", "../api/**/*.spec.ts", "../api/**/*.test.ts"]
}
